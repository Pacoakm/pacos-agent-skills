diff --git a/app/src/song.ts b/app/src/song.ts
new file mode 100644
index 0000000..9ce74c8
--- /dev/null
+++ b/app/src/song.ts
@@ -0,0 +1,5 @@
+// Which song the app plays: ?song=<id> (default: the P(doom) video).
+// A song other than pdoom keeps its analysis in data/<id>/ and its audio in audio/<id>.wav.
+export const SONG = new URLSearchParams(location.search).get('song') ?? 'pdoom';
+export const DATA_DIR = SONG === 'pdoom' ? 'data/' : `data/${SONG}/`;
+export const AUDIO_URL = SONG === 'pdoom' ? 'audio/pdoom.mp3' : `audio/${SONG}.wav`;
